{
  "name": "prepaid-dealer-portal",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Multi-page prepaid dealer portal capstone",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check:preview": "node scripts/check-preview.mjs",
    "test:auth-ui": "playwright test",
    "test:draft": "node --test tests/draft.test.js",
    "test:catalog-ui": "playwright test --config playwright.catalog.config.js",
    "test:submission": "node --test tests/submission.test.js",
    "test:submission-ui": "playwright test --config playwright.submission.config.js",
    "test:history": "node --test tests/history.test.js",
    "test:history-ui": "playwright test --config playwright.history.config.js",
    "test:session": "node --test tests/session.test.js",
    "test:session-ui": "playwright test --config playwright.session.config.js",
    "test:admin-products": "node --test tests/admin-products.test.js",
    "test:admin-products-ui": "playwright test --config playwright.admin-products.config.js",
    "test:admin-dealers": "node --test tests/admin-dealers.test.js",
    "test:admin-dealers-ui": "playwright test --config playwright.admin-dealers.config.js",
    "test:admin-orders": "node --test tests/admin-orders.test.js",
    "test:admin-orders-ui": "playwright test --config playwright.admin-orders.config.js",
    "test:documents": "node --test tests/document-publish.test.js tests/document-download.test.js",
    "test:documents-browser": "node --test tests/document-download-browser.test.js",
    "test:document-ui": "node --test tests/document-ui.test.js",
    "test:document-ui-browser": "playwright test --config playwright.documents.config.js",
    "test:visual": "playwright test --config playwright.visual.config.js",
    "test:catalog-feedback-ui": "playwright test --config playwright.catalog-feedback.config.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "pdf-lib": "1.17.1",
    "supabase": "^3.2.0",
    "vite": "^8.0.0"
  }
}
